<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Third Branch</title>
  <style>
    :root{
      --bg:#000;
      --gold:#d4af37;
      --muted:rgba(212,175,55,0.12);
      --input-height:54px;
      --max-width:820px;
      --radius:10px;
      --font: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    html,body{height:100%}
    body{
      margin:0;
      background:var(--bg);
      color:var(--gold);
      font-family:var(--font);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:40px;
    }
    .wrap{
      max-width:var(--max-width);
      width:100%;
      text-align:center;
    }
    .message{
      font-weight:600;
      letter-spacing:0.02em;
      text-transform:uppercase;
      line-height:1.35;
      margin-bottom:32px;
      font-size:14px;
      color:var(--gold);
      background:linear-gradient(90deg, rgba(212,175,55,0.04), transparent);
      padding:18px;
      border-radius:8px;
    }
    .search-row{
      display:flex;
      justify-content:center;
      gap:12px;
      align-items:center;
      margin-bottom:20px;
      flex-wrap:wrap;
    }
    .search-form{
      display:flex;
      align-items:center;
      background:rgba(255,255,255,0.02);
      border-radius:var(--radius);
      padding:8px;
      border:1px solid rgba(212,175,55,0.18);
      box-shadow:0 6px 18px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
      width:100%;
      max-width:720px;
    }
    .search-form input[type="text"]{
      background:transparent;
      border:0;
      outline:0;
      color:var(--gold);
      font-size:18px;
      padding:14px 12px;
      flex:1;
    }
    .search-form button{
      background:var(--gold);
      color:#000;
      border:0;
      padding:12px 18px;
      border-radius:8px;
      font-weight:700;
      cursor:pointer;
      font-size:16px;
    }
    .pw-row{
      margin-top:6px;
      display:flex;
      gap:10px;
      justify-content:center;
      align-items:center;
    }
    .pw-row input[type="text"]{
      height:40px;
      padding:8px 10px;
      border-radius:8px;
      border:1px solid rgba(212,175,55,0.18);
      background:transparent;
      color:var(--gold);
      outline:none;
      min-width:240px;
    }
    .pw-row button{
      background:transparent;
      border:1px solid rgba(212,175,55,0.18);
      color:var(--gold);
      padding:8px 12px;
      border-radius:8px;
      cursor:pointer;
    }
    .hidden{display:none}
    .arrow-link{
      display:inline-block;
      margin-top:22px;
      font-size:46px;
      color:var(--gold);
      text-decoration:none;
      transition:transform .15s ease;
    }
    .arrow-link:hover{transform:translateX(6px)}
    .note{margin-top:12px;color:rgba(212,175,55,0.7);font-size:13px}
    @media (max-width:560px){
      .search-form input[type="text"]{font-size:16px}
      .arrow-link{font-size:40px}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="message">
      "TO PASS YOU MUST SEARCH FOR JEREMYWORLD.ORG AND FIND A DONOR NAMED JORGE. THEN, GO BACK HERE AND TYPE IN HIS LAST NAME, AN UNDERSCORE, AND THE NUMBER OF DOLLARS HE DONATED. LOWERCASE PLEASE. EXAMPLE: [sporrer_5]"
    </div>

    <div class="search-row">
      <!-- Google-powered search form -->
      <form class="search-form" action="https://www.google.com/search" method="get" target="_blank" aria-label="Google search form">
        <input type="text" name="q" placeholder="Search Google..." autocomplete="off" />
        <button type="submit">Search</button>
      </form>
    </div>

    <!-- Password guess area -->
    <div class="pw-row" role="region" aria-label="Password guess">
      <input id="pw" type="text" placeholder="Type password guess here (lowercase)"/>
      <button id="pwBtn" type="button">Try</button>
    </div>

    <div id="result" class="hidden" aria-live="polite">
      <!-- Revealed when password is correct -->
    </div>

    <div class="note">If the password is correct a link (arrow) will appear — click it to continue.</div>
  </div>

  <script>
    (function(){
      const SECRET = 'torres_1';
      const pwInput = document.getElementById('pw');
      const btn = document.getElementById('pwBtn');
      const result = document.getElementById('result');

      btn.addEventListener('click', tryPass);
      pwInput.addEventListener('keydown', function(e){
        if(e.key === 'Enter'){ tryPass(); e.preventDefault(); }
      });

      function tryPass(){
        const val = (pwInput.value || '').trim();
        if(val === SECRET){
          // Reveal arrow link to another blank branch website (placeholder)
          result.classList.remove('hidden');
          result.innerHTML = '';

          const link = document.createElement('a');
          link.className = 'arrow-link';
          link.href = 'https://github.com/chaddeu/web_supreme/tree/blank-branch';
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = '➜'; // arrow

          const info = document.createElement('div');
          info.style.marginTop = '12px';
          info.style.color = 'rgba(212,175,55,0.85)';
          info.style.fontSize = '14px';
          info.textContent = 'Continue to the next branch (opens in a new tab).';

          result.appendChild(link);
          result.appendChild(info);
        } else {
          // incorrect
          result.classList.remove('hidden');
          result.innerHTML = '<div style="color:#ff6b6b;font-weight:700">Incorrect — try again.</div>';
        }
      }
    })();
  </script>
</body>
</html>
